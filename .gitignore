venv/

# uv materialises the environments here (.venv core, .venv-dev, .venv-server, and
# .venv-omni for the external comparison arm); every lock IS committed -- uv.lock,
# eval/lingbot_va_robotwin/server-requirements.txt and omni-arm-requirements.txt are
# the artifacts that make "the env that produced this number" reconstructable.
.venv-*/

# Run artifacts live outside the repo (/home/ubuntu/iwm_*), but guard against
# anyone pointing IWM_RESULT_DIR / IWM_LOG_DIR at the working tree by accident.
results/
logs/
*.npz
*.qdstrm
*.nsys-rep
cycle_trace.json

# Design docs stay local (not published)
docs/

